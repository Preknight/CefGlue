<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Xilium.CefGlue.Demo.Avalonia.BrowserView" Background="Green">

	<Grid Background="Green" PointerPressed="Grid_PointerPressed">
		
		<DockPanel Background="Transparent" PointerPressed="DockPanel_PointerPressed">
			<TextBox x:Name="addressTextBox" DockPanel.Dock="Top" KeyDown="OnAddressTextBoxKeyDown" />

			<Decorator x:Name="browserWrapper" KeyDown="OnBrowserWrapperKeyDown"/>

		</DockPanel>
		
	</Grid>

</UserControl>